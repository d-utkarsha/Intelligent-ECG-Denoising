# ============================================================
# Intelligent-ECG-Denoising
# ============================================================


# ============================================================
# 1. GENERATED / LARGE PROCESSED DATA
# ============================================================

# Large processed ECG CSV
dataset/processed/*.csv


# ============================================================
# 2. NSRDB
# Keep ONLY record 16265
# ============================================================

# Ignore everything inside NSRDB
dataset/NSRDB/*

# Keep the NSRDB directory itself
!dataset/NSRDB/

# Keep ALL files belonging to record 16265
!dataset/NSRDB/16265.*


# ============================================================
# 3. NSTDB
# Keep ONLY bw, em and ma noise records
# ============================================================

# Ignore everything inside NSTDB
dataset/NSTDB/*

# Keep the NSTDB directory itself
!dataset/NSTDB/

# Keep BW noise record
!dataset/NSTDB/bw.*

# Keep EM noise record
!dataset/NSTDB/em.*

# Keep MA noise record
!dataset/NSTDB/ma.*


